# =============================================================================
# InvestRight-US — US Paper Trading Configuration
# =============================================================================
# This is a US adaptation for Alpaca Paper Trading.
# The original InvestRight (NSE/Kite) is at https://github.com/shubhook/InvestRight
# Do NOT use NSE/Kite credentials here — this is for US markets only.
# =============================================================================

# -----------------------------------------------------------------------------
# Database & Cache
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/investright
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY_HOURS=24
API_KEY=your-api-key-for-the-rest-api

# -----------------------------------------------------------------------------
# Trading Capital
# -----------------------------------------------------------------------------
TOTAL_CAPITAL=100000          # Your paper trading capital in USD

# -----------------------------------------------------------------------------
# Broker Configuration (US Paper Trading)
# -----------------------------------------------------------------------------
BROKER_MODE=paper             # paper (default) | kite_live (legacy, not for US)

# Alpaca Paper Trading credentials (required for real paper orders)
# Sign up at: https://alpaca.markets/
# Get paper trading keys from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your-alpaca-paper-api-key
ALPACA_SECRET_KEY=your-alpaca-paper-secret-key
ALPACA_PAPER=true             # Always true for this repo

# -----------------------------------------------------------------------------
# LLM Configuration (Optional)
# -----------------------------------------------------------------------------
# Groq API for sentiment analysis and trade review
# Sign up at: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# Legacy Anthropic support (if you prefer Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Legacy Kite Configuration (NOT for US trading, reference only)
# -----------------------------------------------------------------------------
# These are NOT used in US paper trading mode.
# The original InvestRight repo uses these for NSE/BSE (India) trading.
# KITE_API_KEY=your-kite-api-key
# KITE_ACCESS_TOKEN=your-kite-access-token
# KITE_PRODUCT=MIS

# -----------------------------------------------------------------------------
# Backtesting
# -----------------------------------------------------------------------------
BACKTEST_DEFAULT_CAPITAL=100000
BACKTEST_MAX_WORKERS=4

# -----------------------------------------------------------------------------
# Technical Indicators (Advanced - use defaults if unsure)
# -----------------------------------------------------------------------------
ATR_PERIOD=14
SMA_FAST=20
SMA_SLOW=50
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
MAX_KELLY_FRACTION=0.50
MAX_LOSS_HARD_CAP=0.10
SR_WINDOW=10
MIN_CANDLES=30
PATTERN_CONFIDENCE_FLOOR=0.5

# -----------------------------------------------------------------------------
# Capital Management
# -----------------------------------------------------------------------------
DEFAULT_CAPITAL_LIMIT=10.0    # Max % of capital per symbol

# -----------------------------------------------------------------------------
# Flask
# -----------------------------------------------------------------------------
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:8080
